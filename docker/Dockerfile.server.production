# syntax=docker/dockerfile:1.4

# ==========================================
# Production Dockerfile for Hono Server
# Multi-stage build optimized for production
# TypeScript compilation with health checks
# ==========================================

ARG NODE_VERSION=22-alpine
ARG PNPM_VERSION=9.15.4

# ==========================================
# Base stage with security and optimizations
# ==========================================
FROM node:${NODE_VERSION} AS base

# Install security and build dependencies
RUN apk add --no-cache \
    libc6-compat \
    dumb-init \
    curl \
    && rm -rf /var/cache/apk/*

# Install pnpm globally
RUN corepack enable && corepack prepare pnpm@${PNPM_VERSION} --activate

# Create app directory with proper permissions
WORKDIR /app

# Create non-root user
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 --shell /bin/bash hono

# ==========================================
# Dependency installation with caching
# ==========================================
FROM base AS deps

# Copy only dependency manifests first (max cache reuse)
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./

# Copy workspace package.json files only
COPY apps/server/package.json ./apps/server/package.json
COPY packages/auth/package.json ./packages/auth/package.json
COPY packages/db/package.json ./packages/db/package.json
COPY packages/api/package.json ./packages/api/package.json
COPY packages/config/package.json ./packages/config/package.json
COPY packages/env/package.json ./packages/env/package.json

# Install dependencies with correct pnpm cache
RUN --mount=type=cache,id=pnpm-store,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile --prefer-offline

# ==========================================
# TypeScript compilation stage
# ==========================================
FROM deps AS typescript

ENV NODE_ENV=production

# Copy installed dependencies
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/apps/server/node_modules ./apps/server/node_modules
COPY --from=deps /app/packages/api/node_modules ./packages/api/node_modules
COPY --from=deps /app/packages/db/node_modules ./packages/db/node_modules
COPY --from=deps /app/packages/auth/node_modules ./packages/auth/node_modules
COPY --from=deps /app/packages/env/node_modules ./packages/env/node_modules
# COPY --from=deps /app/packages/ui/node_modules ./packages/ui/node_modules

# Copy source code
COPY . .

# TypeScript compilation
RUN pnpm --filter server type-check

# ==========================================
# Builder stage - Build Hono server
# ==========================================
FROM typescript AS builder

ENV NODE_ENV=production

# Build packages first (server depends on these)
RUN pnpm --filter @ecomerceNextjs/env build
RUN pnpm --filter @ecomerceNextjs/db build
RUN pnpm --filter @ecomerceNextjs/auth build
RUN pnpm --filter @ecomerceNextjs/api build
RUN pnpm --filter @ecomerceNextjs/config build

# Generate Prisma client
# RUN pnpm --filter @ecomerceNextjs/db db:generate
 # RUN pnpm --filter @ecomerceNextjs/db db:push

# Build the server application
RUN pnpm --filter server build
# ==========================================
# Production runner for Server App
# ==========================================
FROM base AS runner

ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

# Create app directories
RUN mkdir -p /app/logs /app/tmp && \
    chown -R hono:nodejs /app

# Switch to non-root user
USER hono

# Copy production node_modules from builder
COPY --from=builder --chown=hono:nodejs /app/node_modules ./node_modules
COPY --from=builder --chown=hono:nodejs /app/apps/server/node_modules ./apps/server/node_modules
COPY --from=builder --chown=hono:nodejs /app/packages/api/node_modules ./packages/api/node_modules
COPY --from=builder --chown=hono:nodejs /app/packages/db/node_modules ./packages/db/node_modules
COPY --from=builder --chown=hono:nodejs /app/packages/auth/node_modules ./packages/auth/node_modules
COPY --from=builder --chown=hono:nodejs /app/packages/env/node_modules ./packages/env/node_modules
COPY --from=builder --chown=hono:nodejs /app/packages/ui/node_modules ./packages/ui/node_modules

# Copy Prisma artifacts
COPY --from=builder --chown=hono:nodejs /app/packages/db/prisma ./packages/db/prisma
COPY --from=builder --chown=hono:nodejs /app/packages/db/prisma.config.ts ./packages/db/prisma.config.ts
# COPY --from=builder --chown=hono:nodejs /app/node_modules/.prisma ./node_modules/.prisma

# Copy built server application
COPY --from=builder --chown=hono:nodejs /app/apps/server/dist ./apps/server/dist

# Copy package.json files for workspace packages (required for module resolution)
COPY --from=builder --chown=hono:nodejs /app/packages/db/package.json ./packages/db/package.json
COPY --from=builder --chown=hono:nodejs /app/packages/api/package.json ./packages/api/package.json
COPY --from=builder --chown=hono:nodejs /app/packages/auth/package.json ./packages/auth/package.json
COPY --from=builder --chown=hono:nodejs /app/packages/config/package.json ./packages/config/package.json
COPY --from=builder --chown=hono:nodejs /app/packages/env/package.json ./packages/env/package.json
COPY --from=builder --chown=hono:nodejs /app/apps/server/package.json ./apps/server/package.json
COPY --from=builder --chown=hono:nodejs /app/package.json ./package.json
COPY --from=builder --chown=hono:nodejs /app/pnpm-workspace.yaml ./pnpm-workspace.yaml

# Copy built packages that server depends on
COPY --from=builder --chown=hono:nodejs /app/packages/db/dist ./packages/db/dist
COPY --from=builder --chown=hono:nodejs /app/packages/api/dist ./packages/api/dist
COPY --from=builder --chown=hono:nodejs /app/packages/auth/dist ./packages/auth/dist
COPY --from=builder --chown=hono:nodejs /app/packages/env/dist ./packages/env/dist



# Expose port
EXPOSE 3000

# Health check with proper endpoint
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:3000/api || exit 1

# Use dumb-init for proper signal handling
ENTRYPOINT ["dumb-init", "--"]

# Start the application
CMD ["node", "apps/server/dist/index.js"]
