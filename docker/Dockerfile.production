# syntax=docker/dockerfile:1.4

# ==========================================
# Multi-stage production Dockerfile for monorepo
# Optimized for Vercel serverless + Docker compatibility
# ==========================================



ARG APP_NAME=web
ARG NODE_VERSION=22-alpine
ARG PNPM_VERSION=9.15.4
ARG DATABASE_URL



# ==========================================
# Base stage with security and optimizations
# ==========================================
FROM node:${NODE_VERSION} AS base
ENV DATABASE_URL=$DATABASE_URL
# Install security and build dependencies
RUN apk add --no-cache \
    libc6-compat \
    dumb-init \
    curl \
    && rm -rf /var/cache/apk/*

# Install pnpm globally
RUN corepack enable && corepack prepare pnpm@${PNPM_VERSION} --activate

# Create app directory with proper permissions
WORKDIR /app

# Create non-root user
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 --shell /bin/bash nextjs

# ==========================================
# Dependency installation with caching
# ==========================================

FROM base AS deps

ARG APP_NAME

# Copy only dependency manifests first (max cache reuse)
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./

# Copy workspace package.json files only
COPY apps/${APP_NAME}/package.json ./apps/${APP_NAME}/package.json

COPY packages/auth/package.json ./packages/auth/package.json
COPY packages/db/package.json ./packages/db/package.json
COPY packages/api/package.json ./packages/api/package.json
COPY packages/ui/package.json ./packages/ui/package.json
COPY packages/config/package.json ./packages/config/package.json
# (Add others if needed)

# Install dependencies with correct pnpm cache
RUN --mount=type=cache,id=pnpm-store,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile --prefer-offline

# ==========================================
# TypeScript compilation stage
# ==========================================
FROM deps AS typescript

ARG APP_NAME
ARG NODE_ENV=production

ENV NODE_ENV=${NODE_ENV}
ENV NEXT_TELEMETRY_DISABLED=1

# Copy installed dependencies
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/apps/${APP_NAME}/node_modules ./apps/${APP_NAME}/node_modules
COPY --from=deps /app/packages/*/node_modules ./packages/*/node_modules

# Copy source code
COPY . .

# TypeScript compilation
RUN pnpm --filter ${APP_NAME} type-check

# ==========================================
# Build stage
# ==========================================
FROM typescript AS builder

ARG APP_NAME
ARG NODE_ENV=production

# Generate Prisma client
RUN pnpm --filter @ecomerceNextjs/db db:generate

# Build the application
RUN pnpm --filter ${APP_NAME} build

# ==========================================
# Production dependencies only
# ==========================================
FROM base AS deps-production

ARG APP_NAME

# Copy package files and source for production dependencies only
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/${APP_NAME} ./apps/${APP_NAME}/
COPY packages/ ./packages/

# Install production dependencies only
RUN --mount=type=cache,id=pnpm-store,target=/root/.local/share/pnpm/store \
    pnpm install --prod --frozen-lockfile --prefer-offline --ignore-scripts

# ==========================================
# Production runner for Web App
# ==========================================
FROM base AS web-runner

ARG NODE_ENV=production
ARG PORT=3000

# Environment variables
ENV NODE_ENV=${NODE_ENV}
ENV PORT=${PORT}
ENV HOSTNAME="0.0.0.0"
ENV NEXT_TELEMETRY_DISABLED=1

# Create app directories
RUN mkdir -p /app/logs /app/tmp && \
    chown -R nextjs:nodejs /app

# Switch to non-root user
USER nextjs

# Copy production dependencies
COPY --from=deps-production --chown=nextjs:nodejs /app/node_modules ./node_modules
COPY --from=deps-production --chown=nextjs:nodejs /app/apps/web/node_modules ./apps/web/node_modules
COPY --from=deps-production --chown=nextjs:nodejs /app/packages/*/node_modules ./packages/*/node_modules

# Copy Prisma artifacts
COPY --from=builder --chown=nextjs:nodejs /app/packages/db/prisma ./packages/db/prisma
# COPY --from=builder --chown=nextjs:nodejs /app/node_modules/.prisma ./node_modules/.prisma

# Copy built application
COPY --from=builder --chown=nextjs:nodejs /app/apps/web/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=builder --chown=nextjs:nodejs /app/apps/web/public ./apps/web/public

# Expose port
EXPOSE ${PORT}

# Health check with proper endpoint
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:${PORT}/api/health || exit 1

# Use dumb-init for proper signal handling
ENTRYPOINT ["dumb-init", "--"]

# Start the application
CMD ["node", "apps/web/server.js"]

# ==========================================
# Production runner for Server App
# ==========================================
FROM base AS server-runner

ARG NODE_ENV=production
ARG PORT=3001

# Environment variables
ENV NODE_ENV=${NODE_ENV}
ENV PORT=${PORT}
ENV HOSTNAME="0.0.0.0"

# Create app directories
RUN mkdir -p /app/logs /app/tmp && \
    chown -R nextjs:nodejs /app

# Switch to non-root user
USER nextjs

# Copy production dependencies
COPY --from=deps-production --chown=nextjs:nodejs /app/node_modules ./node_modules
COPY --from=deps-production --chown=nextjs:nodejs /app/apps/server/node_modules ./apps/server/node_modules
COPY --from=deps-production --chown=nextjs:nodejs /app/packages/*/node_modules ./packages/*/node_modules

# Copy Prisma artifacts
COPY --from=builder --chown=nextjs:nodejs /app/packages/db/prisma ./packages/db/prisma
COPY --from=builder --chown=nextjs:nodejs /app/node_modules/.prisma ./node_modules/.prisma

# Copy built server application
COPY --from=builder --chown=nextjs:nodejs /app/apps/server/dist ./apps/server/dist
COPY --from=builder --chown=nextjs:nodejs /app/packages/db/dist ./packages/db/dist

# Expose port
EXPOSE ${PORT}

# Health check with proper endpoint
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:${PORT}/health || exit 1

# Use dumb-init for proper signal handling
ENTRYPOINT ["dumb-init", "--"]

# Start the application
CMD ["node", "apps/server/dist/index.js"]

# ==========================================
# Final stage selector
# ==========================================
FROM web-runner AS runner
