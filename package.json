{
  "name": "ecomerceNextjs",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "build:packages": "pnpm --filter \"@ecomerceNextjs/*\" build",
    "build:server": "turbo run server#build",
    "build:types": "turbo run build:types",
    "build:web": "turbo run web#build",
    "check": "turbo lint && turbo type-check",
    "check:fix": "turbo lint:fix",
    "clean": "turbo clean",
    "clean:build": "pnpm -r exec rimraf .next dist ",
    "clean:deps": "pnpm -r exec rimraf node_modules && rimraf node_modules pnpm-lock.yaml .turbo",
    "db:generate": "turbo --filter @ecomerceNextjs/db db:generate",
    "db:migrate": "turbo --filter @ecomerceNextjs/db  db:migrate",
    "db:pull": "turbo --filter @ecomerceNextjs/db  db:pull",
    "db:push": "turbo --filter @ecomerceNextjs/db  db:push",
    "db:seed": "turbo --filter @ecomerceNextjs/db  db:seed",
    "db:start": "turbo --filter @ecomerceNextjs/db run db:start",
    "db:stop": "turbo --filter @ecomerceNextjs/db run db:stop",
    "db:studio": "turbo --filter @ecomerceNextjs/db  db:studio",
    "deploy:all": "./scripts/deploy-pnpm.sh all production",
    "deploy:preview": "./scripts/deploy-pnpm.sh all preview",
    "deploy:server": "pnpm --filter server run deploy",
    "deploy:web": "pnpm --filter web run deploy",
    "dev": "node scripts/dev.mjs",
    "dev:api": "pnpm --filter @ecomerceNextjs/api dev",
    "dev:full": "turbo run dev",
    "dev:server": "turbo run dev --filter=server...",
    "dev:web": "turbo -F web dev",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "nuke": " pnpm run clean:build && pnpm -r exec rimraf .turbo && pnpm run clean:deps ",
    "start": "concurrently \"pnpm start:server\" \"pnpm start:web\"",
    "start:server": "pnpm --filter server run start",
    "start:web": "pnpm --filter web run start",
    "type-check": "turbo type-check",
    "ui:add": "pnpm --filter @workspace/ui run ui:add"
  },
  "dependencies": {
    "@ecomerceNextjs/config": "workspace:*",
    "next-themes": "^0.4.6",
    "pg": "^8.18.0",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.14",
    "@nkzw/eslint-plugin": "^2.0.0",
    "@nkzw/oxlint-config": "^1.0.1",
    "concurrently": "^9.2.1",
    "dotenv": "^17.2.3",
    "eslint-plugin-no-only-tests": "^3.3.0",
    "eslint-plugin-perfectionist": "^5.6.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "oxfmt": "^0.34.0",
    "oxlint": "^1.49.0",
    "oxlint-tsgolint": "^0.14.2",
    "rimraf": "^6.1.2",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsup": "^8.5.1",
    "turbo": "^2.8.3",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.56.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.4"
}
