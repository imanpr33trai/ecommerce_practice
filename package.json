{
  "dependencies": {
    "@dotenvx/dotenvx": "^1.51.2",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-slot": "^1.2.4",
    "dotenv": "^17.2.2",
    "next-themes": "^0.4.6",
    "pg": "^8.16.3",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@ecomerceNextjs/config": "workspace:*",
    "@types/bun": "^1.3.3",
    "baseline-browser-mapping": "^2.9.11",
    "turbo": "^2.5.4"
  },
  "name": "ecomerceNextjs",
  "packageManager": "bun@1.3.3",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "check": "biome check --write .",
    "check-types": "turbo check-types",
    "db:down": "turbo -F @ecomerceNextjs/db db:down",
    "db:generate": "turbo -F @ecomerceNextjs/db db:generate",
    "db:migrate": "turbo -F @ecomerceNextjs/db db:migrate",
    "db:push": "turbo -F @ecomerceNextjs/db db:push",
    "db:pull": "turbo -F @ecomerceNextjs/db db:pull",
    "db:seed": "turbo -F server db:seed",
    "db:start": "turbo -F @ecomerceNextjs/db db:start",
    "db:stop": "turbo -F @ecomerceNextjs/db db:stop",
    "db:studio": "turbo -F @ecomerceNextjs/db db:studio",
    "db:watch": "turbo -F @ecomerceNextjs/db db:watch",
    "dev": "turbo dev",
    "dev:native": "turbo -F native dev",
    "dev:server": "turbo -F server dev",
    "dev:web": "turbo -F web dev",
    "ui:add": "bunx shadcn@latest add"
  },
  "type": "module",
  "workspaces": {
    "catalog": {
      "@prisma/client": "^7.0.0",
      "@tanstack/react-query": "^5.90.12",
      "@trpc/client": "^11.8.0",
      "@trpc/server": "^11.8.0",
      "@trpc/tanstack-react-query": "^11.8.0",
      "client-only": "^0.0.1",
      "better-auth": "^1.4.0",
      "dotenv": "^17.2.2",
      "hono": "^4.8.2",
      "server-only": "^0.0.1",
      "superjson": "^2.2.6",
      "zod": "^4.2.1"
    },
    "packages": [
      "apps/*",
      "packages/*"
    ]
  }
}
