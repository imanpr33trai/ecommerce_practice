{
  "name": "ecomerceNextjs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm -r --sort run build",
    "build:types": "pnpm -r run build:types",
    "build:web": "pnpm --filter web run build",
    "build:server": "pnpm --filter server run build",
    "dev": "pnpm -r --parallel run dev",
    "dev:web": "pnpm --filter web run dev",
    "dev:server": "pnpm --filter server run dev",
    "start": "concurrently \"pnpm start:server\" \"pnpm start:web\"",
    "start:web": "pnpm --filter web run start",
    "start:server": "pnpm --filter server run start",
    "lint": "pnpm -r run lint",
    "type-check": "pnpm -r run type-check",
    "check": "pnpm run lint && pnpm run type-check",
    "check:fix": "pnpm -r run lint:fix",
    "format": "biome format --write .",
    "clean": "pnpm -r run clean",
    "clean:deps": "pnpm -r exec rimraf node_modules && rimraf node_modules pnpm-lock.yaml",
    "clean:build": "pnpm -r exec rimraf .next .turbo dist",
    "nuke": "pnpm run clean:deps && pnpm run clean:build",
    "postinstall": "pnpm --filter @ecomerceNextjs/db run db:generate",
    "db:generate": "pnpm --filter @ecomerceNextjs/db run db:generate",
    "db:migrate": "pnpm --filter @ecomerceNextjs/db run db:migrate",
    "db:push": "pnpm --filter @ecomerceNextjs/db run db:push",
    "db:pull": "pnpm --filter @ecomerceNextjs/db run db:pull",
    "db:seed": "pnpm --filter server run db:seed",
    "db:studio": "pnpm --filter @ecomerceNextjs/db run db:studio",
    "db:start": "pnpm --filter @ecomerceNextjs/db run db:start",
    "db:stop": "pnpm --filter @ecomerceNextjs/db run db:stop",
    "ui:add": "pnpm --filter @workspace/ui run ui:add",
    "deploy:web": "pnpm --filter web run deploy",
    "deploy:server": "pnpm --filter server run deploy",
    "deploy:all": "./scripts/deploy-pnpm.sh all production",
    "deploy:preview": "./scripts/deploy-pnpm.sh all preview"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "concurrently": "^9.1.0",
    "dotenv": "^17.2.3",
    "esbuild": "^0.27.2",
    "rimraf": "^6.0.1",
    "tsc-alias": "^1.8.16",
    "tsup": "^8.5.1",
    "typescript": "^5.8.2"
  },
  "dependencies": {
    "next-themes": "^0.4.6",
    "pg": "^8.16.3",
    "sonner": "^2.0.7",
    "@ecomerceNextjs/config": "workspace:*"
  }
}
