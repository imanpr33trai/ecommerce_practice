model Image {
  id        String   @id @default(cuid())
  url       String
  altText   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  productId String?
  isPrimary Boolean  @default(false)
  width     Int?
  height    Int?
  fileSize  Int?
  product   Product? @relation(fields: [productId], references: [id])
}
