{
  "extends": "../config/node.json",
  "include": ["src/**/*.ts", "../env/src/env.d.ts"],
  "compilerOptions": {
    "composite": true,
    "rootDir": "./src",
    "outDir": "./dist/",
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "sourceMap": true
  },
  "tsc-alias": {
    "resolveFullPaths": true
  },
  "exclude": ["node_modules", "dist"]
}
