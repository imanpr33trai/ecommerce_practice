{
	"extends": [
		"@ecomerceNextjs/config/tsconfig.base.json",
		"../../tsconfig.json"
	],
	"compilerOptions": {
		"module": "esnext",
		"moduleResolution": "bundler",
		"declaration": true,
		"declarationMap": true,
		"sourceMap": true,
		"outDir": "dist",
		"paths": {
			"@/*": [
				"../../*"
			]
		}
	},
	"include": [
		"prisma/**/*",
		"src/**/*"
	],
	"exclude": [
		"dist",
		"node_modules",
		"prisma/migrations"
	]
}