{
  "extends": ["@ecomerceNextjs/config/tsconfig.base.json", "../../tsconfig.json"],
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "paths": {
      "@/*": ["../../*"]
    }
  },
  "include": ["prisma/**/*", "src/**/*"],
  "exclude": ["dist", "node_modules", "prisma/migrations"]
}

