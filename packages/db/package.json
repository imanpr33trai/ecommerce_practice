{
  "dependencies": {
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.2.0",
    "@prisma/client-runtime-utils": "^7.2.0",
    "pg": "^8.16.3",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@ecomerceNextjs/config": "workspace:*",
    "@ecomerceNextjs/env": "workspace:*",
    "@types/pg": "^8.11.11",
    "prisma": "^7.2.0",
    "typescript": "^5.0.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "name": "@ecomerceNextjs/db",
  "peerDependencies": {
    "typescript": "^5"
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "build:types": "tsc --emitDeclarationOnly",
    "lint": "biome check .",
    "build": "bun tsc -p tsconfig.build.json",
    "db:generate": "bunx --bun prisma generate",
    "db:migrate": "bunx --bun prisma migrate dev",
    "db:push": "bunx --bun prisma db push",
    "db:pull": "bunx --bun prisma db pull",
    "db:studio": "bunx --bun prisma studio",
    "db:seed": "bun run prisma/seed.ts",
    "db:start": "docker compose up -d",
    "db:watch": "docker compose up",
    "db:stop": "docker compose stop",
    "db:down": "docker compose down"
  },
  "type": "module"
}