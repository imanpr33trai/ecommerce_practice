{
  "extends": "@ecomerceNextjs/config/react-library.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "baseUrl": ".",
    "paths": {
      "@workspace/ui/*": ["src/*"]
    }
  },
  "include": ["src/**/*", "../env/src/env.d.ts"],
  "exclude": ["node_modules", "dist"]
}
