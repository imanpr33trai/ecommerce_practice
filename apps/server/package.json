{
  "dependencies": {
    "@ecomerceNextjs/api": "workspace:*",
    "@ecomerceNextjs/auth": "workspace:*",
    "@ecomerceNextjs/db": "workspace:*",
    "@ecomerceNextjs/env": "workspace:*",
    "@hono/zod-validator": "^0.7.6",
    "better-auth": "^1.4.0",
    "hono": "^4.11.3",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@ecomerceNextjs/config": "workspace:*",
    "@types/bun": "^1.2.6",
    "typescript": "^5.8.2"
  },
  "main": "src/index.ts",
  "name": "server",
  "scripts": {
    "dev": "bun --env-file=../../.env.development run --hot src/index.ts",
    "type-check": "tsc --noEmit",
    "build": "bun tsc -p tsconfig.build.json",
    "compile": "bun build ./src/index.ts --compile --outfile server",
    "start": "bun run ./dist/index.js"
  },
  "type": "module"
}
