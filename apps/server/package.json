{
  "name": "server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsup",
    "dev": " tsup --watch --onSuccess \"node dist/index.js\"",
    "build:types": "tsc --emitDeclarationOnly",
    "build:watch": "tsc -p tsconfig.build.json --watch",
    "start": "node dist/index.js",
    "type-check": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "clean": "rimraf dist",
    "deploy": "vercel --prod",
    "deploy:preview": "vercel"
  },
  "dependencies": {
    "@ecomerceNextjs/api": "workspace:*",
    "@ecomerceNextjs/auth": "workspace:*",
    "@ecomerceNextjs/db": "workspace:*",
    "@hono/node-server": "^1.19.9",
    "@hono/zod-validator": "^0.7.6",
    "better-auth": "^1.4.0",
    "@ecomerceNextjs/config": "workspace:*",
    "dotenv": "^16.4.7",
    "hono": "^4.11.3",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/node": "^25.0.9",
    "esbuild": "^0.27.2",
    "typescript": "^5.8.2"
  },
  "main": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
