{
  "name": "server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "build:types": "tsc --emitDeclarationOnly",
    "build:watch": "tsc -p tsconfig.build.json --watch",
    "check-types": "tsc -b",
    "clean": "rimraf dist",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "deploy": "vercel --prod",
    "deploy:preview": "vercel",
    "dev": "tsx watch src/index.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "start": "node dist/index.mjs",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@ecomerceNextjs/api": "workspace:*",
    "@ecomerceNextjs/auth": "workspace:*",
    "@ecomerceNextjs/config": "workspace:*",
    "@ecomerceNextjs/db": "workspace:*",
    "@ecomerceNextjs/env": "workspace:*",
    "@hono/node-server": "^1.19.9",
    "@hono/zod-validator": "^0.7.6",
    "better-auth": "catalog:",
    "dotenv": "catalog:",
    "hono": "^4.8.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "^22.13.14",
    "tsdown": "^0.16.5",
    "tsx": "^4.19.2",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
