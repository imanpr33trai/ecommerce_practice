{
	"dependencies": {
		"@ecomerceNextjs/api": "workspace:*",
		"@ecomerceNextjs/auth": "workspace:*",
		"@ecomerceNextjs/db": "workspace:*",
		"@ecomerceNextjs/env": "workspace:*",
		"@hono/trpc-server": "^0.4.0",
		"@trpc/server": "catalog:",
		"better-auth": "catalog:",
		"dotenv": "catalog:",
		"hono": "catalog:",
		"zod": "^4.1.11"
	},
	"devDependencies": {
		"@ecomerceNextjs/config": "workspace:*",
		"@types/bun": "^1.2.6",
		"tsdown": "^0.16.5",
		"typescript": "^5.8.2"
	},
	"main": "src/index.ts",
	"name": "server",
	"scripts": {
		"build": "tsdown",
		"check-types": "tsc -b",
		"compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
		"dev": "bun run --hot src/index.ts",
		"start": "bun run dist/index.js"
	},
	"type": "module"
}