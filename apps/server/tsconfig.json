{
  "extends": "@ecomerceNextjs/config/node.json",
  "include": ["src"],
  "exclude": ["node_modules"],
  "compilerOptions": {
    "rootDir": "src",
    "baseUrl": ".",
    "paths": {
      "@ecomerceNextjs/api": ["packages/api/dist"],
      "@ecomerceNextjs/auth": ["packages/auth/dist"],
      "@ecomerceNextjs/db": ["packages/db/dist"],
      "@ecomerceNextjs/env": ["packages/env/dist"],
      "@workspace/ui/*": ["packages/ui/src/*"]
    }
  }
}
