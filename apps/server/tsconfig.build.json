{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,

    "outDir": "dist",
    "rootDir": "src",

    "module": "esnext",
    "target": "es2022",
    "moduleResolution": "bundler",

    "sourceMap": true,

    "skipLibCheck": true
  },
  "include": ["src"],
  "exclude": ["dist", "node_modules"]
}
