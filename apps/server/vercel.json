{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "installCommand": " bun install",
  "buildCommand": " bun run build:server",
  "outputDirectory": "apps/server/dist",
  "framework": "hono",
  "env": {
    "NODE_ENV": "production"
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/index.js"
    }
  ]
}