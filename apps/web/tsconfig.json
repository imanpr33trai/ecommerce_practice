{
  "extends": "../../packages/config/nextjs.json",
  "compilerOptions": {
    "composite": true,
    "allowImportingTsExtensions": false,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@comp/*": ["../../packages/ui/src/components/*"],
      "@workspace/ui/*": ["../../packages/ui/src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "../../packages/env/src/env.d.ts",
    "../../packages/ui/src/**/*.ts",
    "../../packages/auth/src/**/*.ts",
    "../../packages/ui/src/**/*.tsx"
  ],
  "exclude": ["node_modules"]
}
