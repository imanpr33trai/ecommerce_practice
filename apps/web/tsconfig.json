{
  "extends": "@ecomerceNextjs/config/nextjs.json",
  "compilerOptions": {
    "baseUrl": ".",
    "allowImportingTsExtensions": false,
    "paths": {
      "@/*": ["src/*"],
      "@comp/*": ["../../packages/ui/src/components/*"],
      "@workspace/ui/*": ["../../packages/ui/src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
