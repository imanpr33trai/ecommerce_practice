# ==========================================
# Environment Variables for Docker Deployment
# Copy this file to .env and update values
# ==========================================

# ==========================================
# Docker Compose Configuration
# ==========================================
COMPOSE_PROJECT_NAME=ecommerce

# ==========================================
# PostgreSQL Database
# ==========================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=12345
POSTGRES_DB=ecommerce
POSTGRES_PORT=5432

# ==========================================
# Redis Cache
# ==========================================
REDIS_PORT=6379
# Optional: Set password for Redis
# REDIS_PASSWORD=change-me-in-production

# ==========================================
# Application Ports
# ==========================================
SERVER_PORT=3000
WEB_PORT=3001
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# ==========================================
# Server (Hono Backend) Configuration
# ==========================================
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0
LOG_LEVEL=info

# Database connection (internal Docker network)
DATABASE_URL=postgresql://postgres:12345@postgres:5432/ecommerce

# Authentication
JWT_SECRET=generate-a-secure-secret-at-least-32-characters-long
BETTER_AUTH_SECRET=generate-a-secure-secret-at-least-32-characters-long
BETTER_AUTH_URL=http://localhost:3000
SERVER_URL=http://localhost:3000

# CORS Configuration
CORS_ORIGIN=http://localhost:3001

# Migration Settings
AUTO_MIGRATE=false

# ==========================================
# Web (Next.js Frontend) Configuration
# ==========================================
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_TELEMETRY_DISABLED=1

# ==========================================
# Nginx Configuration
# ==========================================
# For production, set your domain name
# SERVER_NAME=your-domain.com

# ==========================================
# SSL/TLS Configuration (Production)
# ==========================================
# Generate SSL certificates with Let's Encrypt or your CA
# Place certificates in docker/nginx/ssl/
# SSL_CERTIFICATE=/etc/nginx/ssl/fullchain.pem
# SSL_CERTIFICATE_KEY=/etc/nginx/ssl/privkey.pem

# ==========================================
# Resource Limits (Optional)
# ==========================================
# SERVER_MEMORY_LIMIT=512M
# SERVER_CPU_LIMIT=0.5
# WEB_MEMORY_LIMIT=1G
# WEB_CPU_LIMIT=1.0
