# ================================
# Environment Variables Template
# Copy this to .env.development.local/.env.production.local and update
# ================================

# Application
NODE_ENV=development
HOSTNAME=0.0.0.0

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ecommerce
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/ecommerce?schema=public

# JWT
JWT_SECRET=your-jwt-secret-here

# CORS
CORS_ORIGIN=http://localhost:3000

# Logging
LOG_LEVEL=debug

# Auto-migrate
AUTO_MIGRATE=true

# Next.js
NEXT_TELEMETRY_DISABLED=1

# Port Configuration (Web: 3001, Server: 3000)
PORT=3001
SERVER_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://server:3000
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Better Auth Configuration
BETTER_AUTH_SECRET=your-secret-key-at-least-32-characters-long
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000